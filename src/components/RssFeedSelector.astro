---
export interface Props {
  defaultFeed?: "all" | "posts" | "journal";
}

const { defaultFeed = "posts" } = Astro.props;

const feeds = [
  { id: "posts", label: "Posts", href: "/posts/rss.xml" },
  { id: "journal", label: "Journal", href: "/journal/rss.xml" },
  { id: "all", label: "All", href: "/rss.html" },
] as const;

const selectedFeed = feeds.find(feed => feed.id === defaultFeed) ?? feeds[0];
const linkLabel = `Subscribe to ${selectedFeed.label} via RSS (opens in a new tab)`;
---

<div class="rss-selector" data-rss-selector>
  <a
    class="rss-link"
    data-rss-link
    href={selectedFeed.href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={linkLabel}
    title={linkLabel}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="rss-icon"
      viewBox="0 0 24 24"
      aria-hidden="true"
      ><path
        d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
      ></path><path
        d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
      ></path><circle cx="6" cy="18" r="2"></circle></svg
    >
    <span>RSS</span>
  </a>
  <span class="rss-separator" aria-hidden="true">·</span>
  <span class="rss-choice">
    <select aria-label="Choose RSS feed" title="Choose RSS feed" data-rss-feed>
      {
        feeds.map(feed => (
          <option
            value={feed.id}
            data-href={feed.href}
            selected={feed.id === selectedFeed.id}
          >
            {feed.label}
          </option>
        ))
      }
    </select>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="chevron"
      viewBox="0 0 24 24"
      aria-hidden="true"><path d="m7 10 5 5 5-5"></path></svg
    >
  </span>
</div>

<script>
  const initializedSelects = new WeakSet();

  function setupRssSelectors() {
    document.querySelectorAll("[data-rss-selector]").forEach(selector => {
      const select =
        selector.querySelector<HTMLSelectElement>("[data-rss-feed]");
      const link = selector.querySelector<HTMLAnchorElement>("[data-rss-link]");

      if (!select || !link) return;

      const feedSelect = select;
      const rssLink = link;

      function updateFeed() {
        const option = feedSelect.selectedOptions[0];
        if (!option?.dataset.href) return;

        const label = `Subscribe to ${option.text} via RSS (opens in a new tab)`;
        rssLink.href = option.dataset.href;
        rssLink.setAttribute("aria-label", label);
        rssLink.title = label;
      }

      updateFeed();

      if (!initializedSelects.has(feedSelect)) {
        feedSelect.addEventListener("change", updateFeed);
        initializedSelects.add(feedSelect);
      }
    });
  }

  setupRssSelectors();
  document.addEventListener("astro:after-swap", setupRssSelectors);
  document.addEventListener("astro:page-load", setupRssSelectors);
  window.addEventListener("pageshow", setupRssSelectors);
</script>

<style>
  .rss-selector {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    color: rgb(var(--color-accent));
    font-size: 0.875rem;
    font-weight: 600;
  }

  .rss-link,
  select {
    min-height: 2.75rem;
    border-radius: 0.5rem;
    color: inherit;
    transition: background-color 150ms ease;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.5rem;
    text-decoration: none;
  }

  .rss-link:hover,
  select:hover {
    background: color-mix(in srgb, rgb(var(--color-accent)) 10%, transparent);
  }

  .rss-link:focus-visible,
  select:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: 2px;
  }

  .rss-icon {
    width: 1.2rem;
    height: 1.2rem;
    fill: currentColor;
  }

  .rss-separator {
    padding: 0 0.1rem;
  }

  .rss-choice {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  select {
    width: calc(7ch + 2.25rem);
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0.35rem 1.75rem 0.35rem 0.5rem;
    font: inherit;
    cursor: pointer;
  }

  option {
    background: rgb(var(--color-fill));
    color: rgb(var(--color-text-base));
  }

  .chevron {
    position: absolute;
    right: 0.4rem;
    width: 1rem;
    height: 1rem;
    pointer-events: none;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .rss-link,
    select {
      transition: none;
    }
  }
</style>
